---
/**
 * Image slot. Renders the image when one is supplied, otherwise a labelled
 * placeholder telling you what goes here and what size to export.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  img?: ImageMetadata;
  label: string;
  size?: string;
  ratio?: string;
  dark?: boolean;
  alt?: string;
  sizes?: string;
  class?: string;
  fit?: 'cover' | 'contain';
  /** Inner margin around the image, e.g. '22%' for logos */
  inset?: string;
  /** Solid background colour, e.g. a brand's own dark */
  bg?: string;
}
const { img, label, size, ratio = '16/9', dark = false, alt = '', sizes = '100vw', class: cls, fit = 'cover', inset, bg } = Astro.props;
const pos = inset ? `inset:${inset};width:calc(100% - 2*${inset});height:calc(100% - 2*${inset});` : '';
---
<div class:list={['slot', cls, { dark, filled: !!img }]} style={`aspect-ratio:${ratio}${bg ? `;background:${bg}` : ''}`}>
  {img ? (
    img.format === 'svg'
      ? <img src={img.src} alt={alt} width={img.width} height={img.height} loading="lazy" decoding="async" style={`object-fit:${fit};${pos}`} />
      : <Image src={img} alt={alt} widths={[...new Set([480, 960, 1600, 2400].filter((w) => w < img.width).concat(Math.min(img.width, 2400)))]} sizes={sizes} loading="lazy" decoding="async" style={`object-fit:${fit};${pos}`} />
  ) : (
    <div class="slot-ph" aria-hidden="true">
      <span class="slot-l">{label}</span>
      {size && <span class="slot-s">{size}</span>}
    </div>
  )}
</div>

<style>
  .slot { position: relative; overflow: hidden; border-radius: 24px; background: #ececec; isolation: isolate; }
  .slot.dark { background: linear-gradient(160deg, #1d1d1d, #0a0a0a 60%, #2a2a2a); }
  .slot img { position: absolute; inset: 0; width: 100%; height: 100%; }
  .slot-ph { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8px; text-align: center; padding: 16px;
    background-image: repeating-linear-gradient(135deg, rgba(0,0,0,.035) 0 1px, transparent 1px 14px); }
  .dark .slot-ph { background-image: repeating-linear-gradient(135deg, rgba(255,255,255,.05) 0 1px, transparent 1px 14px); }
  .slot-l { font: 500 11px/1.3 var(--sans); letter-spacing: .2em; text-transform: uppercase; color: #6b6b6b; }
  .slot-s { font: 400 12px/1 var(--sans); letter-spacing: .06em; color: #9a9a9a; }
  .dark .slot-l { color: #9a9a9a; } .dark .slot-s { color: #6b6b6b; }
</style>
