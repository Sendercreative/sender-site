---
import { Image } from 'astro:assets';
import YouTube from './YouTube.astro';
import type { ImageMetadata } from 'astro';
import type { WorkItem } from '../data/site';

interface Props { item: WorkItem & { phone?: ImageMetadata; photo?: ImageMetadata }; web?: boolean }
const { item: p, web = false } = Astro.props;

const ytId = (u: string) => (u.match(/(?:youtu\.be\/|v=|embed\/|shorts\/)([\w-]{11})/) || [])[1] || u;
const y = p.youtube ? ytId(p.youtube) : null;
const logo = p.img ?? p.inv;
const href = y ? `https://youtu.be/${y}` : p.href ?? '#';
const meta = [p.tag, p.year].filter(Boolean).join(' · ');
const Tag = y || p.video || p.instagram ? 'div' : 'a';
const attrs = y || p.video || p.instagram ? {} : { href };
---
<Tag class="tile" {...attrs}>
  {p.instagram ? (
    <div class="m ig">
      <blockquote class="instagram-media" data-instgrm-permalink={`${p.instagram}?utm_source=ig_embed`} data-instgrm-version="14">
        <a href={p.instagram} target="_blank" rel="noopener">Watch {p.name} on Instagram</a>
      </blockquote>
    </div>
  ) : y ? (
    <YouTube url={p.youtube!} title={p.name} class="m wide" />
  ) : p.video ? (
    <div class="m wide">
      <video class="lazyv" src={p.video.src} poster={p.video.poster} muted loop playsinline controls preload={p.video.poster ? 'none' : 'metadata'} aria-label={p.name}></video>
    </div>
  ) : p.photo ? (
    <div class="m photo">
      <Image src={p.photo} alt={`${p.name} brand`} widths={[360, 720, 1080]} sizes="(max-width:760px) 80vw, 26vw" loading="lazy" decoding="async" />
    </div>
  ) : p.phone ? (
    <div class="m phone" style={`aspect-ratio:${p.phone.width}/${p.phone.height}`}>
      <Image src={p.phone} alt={`${p.name} website on a phone`} widths={[240, 480, 720]} sizes="(max-width:760px) 26vw, 18vw" loading="lazy" decoding="async" />
    </div>
  ) : p.shot ? (
    <div class="m web shot">
      <Image src={p.shot} alt={`${p.name} website`} widths={[480, 960, 1440]} sizes="(max-width:760px) 90vw, 40vw" loading="lazy" decoding="async" />
    </div>
  ) : logo ? (
    <div class:list={['m', { dk: !p.img }]}>
      {logo.format === 'svg'
        ? <img src={logo.src} alt={p.name} width={logo.width} height={logo.height} loading="lazy" decoding="async" />
        : <Image src={logo} alt={p.name} widths={[240, 480]} sizes="(max-width:760px) 60vw, 240px" loading="lazy" decoding="async" />}
    </div>
  ) : (
    <div class:list={['m', 'tph', { web: web || p.dark, dk: p.dark }]}>
      <span class="tph-l">{p.name}</span>
      <span class="tph-s">{p.ph}</span>
    </div>
  )}
  <div class="cap"><span>{p.name}</span><span>{meta}</span></div>
</Tag>

<script>
  // Load Instagram's embed script only once an embed is about to scroll into view.
  const igs = document.querySelectorAll('.instagram-media');
  if (igs.length) {
    const load = () => {
      const w = window as unknown as { instgrm?: { Embeds: { process(): void } } };
      if (w.instgrm) return w.instgrm.Embeds.process();
      if (document.getElementById('ig-embed')) return;
      const s = document.createElement('script');
      s.id = 'ig-embed'; s.async = true; s.src = 'https://www.instagram.com/embed.js';
      document.body.appendChild(s);
    };
    const o = new IntersectionObserver((es) => { if (es.some((e) => e.isIntersecting)) { load(); o.disconnect(); } }, { rootMargin: '600px 0px' });
    igs.forEach((el) => o.observe(el));
  }
</script>
