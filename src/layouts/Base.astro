---
import '@fontsource-variable/jost/wght.css';
import '../styles/global.css';
import { CONTACT } from '../data/site';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Sender Creative | Marketing Agency in Hamilton, Haldimand & Norfolk',
  description = 'We build marketing systems for local businesses in Hamilton, Haldimand and Norfolk: branding, websites, local SEO, social, ads and video. Book a visit.',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'Sender Creative',
  url: Astro.site?.href,
  email: CONTACT.email,
  description: 'Marketing agency for local businesses: branding, websites, local SEO, social media, ads, photo and video.',
  areaServed: ['Hamilton', 'Haldimand County', 'Norfolk County'].map((name) => ({ '@type': 'AdministrativeArea', name })),
  knowsAbout: ['Branding', 'Web design', 'Local SEO', 'Google Business Profile', 'Social media marketing', 'Google Ads', 'Video production'],
  address: { '@type': 'PostalAddress', addressRegion: 'ON', addressCountry: 'CA' },
};
---
<!doctype html>
<html lang="en-CA" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#000000" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Sender Creative" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_CA" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preload" href="/fonts/zelltin-black.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/zelltin-medium.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline>document.documentElement.classList.replace('no-js','js')</script>
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <slot />
  </body>
</html>
