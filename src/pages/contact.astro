---
import Base from '../layouts/Base.astro';
import { CONTACT, PROCESS } from '../data/site';
import '../styles/pages.css';

const site = Astro.site!.href;
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'ContactPage',
    url: new URL('/contact/', site).href,
    about: { '@id': `${site}#org` },
  },
];
---
<Base
  title="Contact Sender Creative | Book a Visit in Hamilton, Haldimand & Norfolk"
  description={`Book a visit with Sender Creative. Call ${CONTACT.phone} or email ${CONTACT.email}. Marketing for local businesses across Hamilton, Haldimand and Norfolk.`}
  schema={schema}
  ctaEyebrow="Sometimes you just gotta"
  ctaHeading="Send’r."
>
  <div class="pg">
    <header class="pg-hero pad">
      <div class="hero-orb" aria-hidden="true"></div>
      <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><span aria-current="page">Contact</span></nav>
      <h1 class="rv">Let’s talk about your business.</h1>
      <p class="lead rv">Tell us what you’re working on. The easiest place to start is a visit: we come to you, see how things run, and tell you honestly what would help.</p>
    </header>

    <section class="sec pad" style="padding-top:0" aria-label="Ways to reach us">
      <div class="cgrid">
        <ul class="cways">
          <li class="dots rv">
            <p class="k">Book a visit</p>
            <a href={CONTACT.booking}>Pick a time →</a>
            <small>We come to you, anywhere across {CONTACT.areas}.</small>
          </li>
          <li class="dots rv">
            <p class="k">Call</p>
            <a href={`tel:${CONTACT.phoneHref}`}>{CONTACT.phone}</a>
          </li>
          <li class="dots rv">
            <p class="k">Email</p>
            <a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a>
          </li>
          <li class="dots rv">
            <p class="k">Where</p>
            <p class="v">{CONTACT.areas}</p>
            <small>And nearby. Ontario, Canada.</small>
          </li>
        </ul>

        <aside class="cpanel rv" aria-labelledby="next-h">
          <h2 id="next-h">What happens next</h2>
          <ol>
            {PROCESS.map((p) => <li><span><b>{p.title}</b>{p.blurb}</span></li>)}
          </ol>
          <a class="btn-light" href={CONTACT.booking}>Book a visit →</a>
        </aside>
      </div>
    </section>
  </div>
</Base>
