---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from '../layouts/Base.astro';
import Tile from '../components/Tile.astro';
import voidBrand from '../assets/home/void-brand.jpg';
import sixDaysBrand from '../assets/home/6days-brand.jpg';
import jbBrand from '../assets/home/jb-brand.jpg';
import { WORK, BOXES, HERO, PROCESS, SYSTEM, CHOICES, CONTACT } from '../data/site';
import { PIECES, ICONS, BRANDS, scatter } from '../data/mess';
import { SYSMAP } from '../data/sysmap';
import '../styles/home.css';

const W = WORK;
const deck = [W.logos[0], W.websites[1], W.logos[3], W.websites[5], W.logos[2], W.websites[4], W.logos[4]].filter(Boolean);
const letters = (s: string) => [...s];
const spots = scatter(PIECES.map((p) => !!p.word));
const workHref = { logos: '/work/#branding', videos: '/work/#video', websites: '/work/#websites' } as const;
/** Homepage Websites panel: only these, in this order. */
const homeSites = ['void-cavitation', '6-days', 'jb-controls']
  .map((slug) => W.websites.find((w) => w.href === `/work/${slug}/`))
  .filter((w): w is NonNullable<typeof w> => Boolean(w))
  .map((w) => ({ ...w, shot: undefined, phone: w.mshot }));
/** Homepage Branding panel: drop these. */
const hideLogos = ['ontario-window-door-products', 'venture-gutter-services'].map((slug) => `/work/${slug}/`);
/** Homepage Branding panel: brand photos in place of plain logos. */
const brandPhoto: Record<string, ImageMetadata> = {
  '/work/void-cavitation/': voidBrand,
  '/work/6-days/': sixDaysBrand,
  '/work/jb-controls/': jbBrand,
};
const homeLogos = W.logos
  .filter((l) => !hideLogos.includes(l.href ?? ''))
  .map((l) => (brandPhoto[l.href ?? ''] ? { ...l, photo: brandPhoto[l.href ?? ''] } : l));
const panel = { ...W, logos: homeLogos, websites: homeSites };
---
<Base page="home">
    <section class="stage" id="stage" aria-label="Introduction and work">
      <div class="pin">
        <div class="bgfx" aria-hidden="true"><b></b><b></b><b></b></div>
        <div class="mask">
          <div class="htxt pad">
            <div class="hblk" id="hblk">
              <span class="lk" id="lk" aria-hidden="true">{letters(HERO[0].word).map((c) => <i>{c}</i>)}</span>
              <h1 class="ag" id="ag" aria-label={`${HERO[0].word} ${HERO[0].lines.join(' ')}`}>
                {HERO[0].lines.map((t) => <span class="pop" aria-hidden="true"><span>{t}</span></span>)}
              </h1>
            </div>
          </div>
        </div>
        <p class="lede" id="lede"><b style="font-weight:400">We'll help you <span>send</span> the right message, in all the right places.</b></p>
        <div class="sub pad"><span>Marketing for local businesses · {CONTACT.areas}</span><span aria-hidden="true">Scroll ↓</span></div>
        <div class="vlab" id="vlab" aria-hidden="true">{BOXES.map((b) => <span>{b.label}</span>)}</div>
        <nav class="rail" id="rail" aria-label="Work sections">
          {BOXES.map((b) => <a href={`#b-${b.key}`} aria-label={b.label}><span>{b.label}</span></a>)}
        </nav>

        <div class="fly" aria-hidden="true">
          <div class="deck">
            {deck.map((p, i) => (
              <div class="fc" style={`--i:${Math.max(0, 3 - i)}`}>
                <div class="fi">
                  {p.video ? (
                    <div class="fm dk"><video src={p.video.src} poster={p.video.poster} autoplay muted loop playsinline preload="metadata"></video></div>
                  ) : p.shot ? (
                    <div class="fm shot"><Image src={p.shot} alt="" widths={[640, 960]} sizes="40vw" loading="lazy" /></div>
                  ) : p.img ? (
                    <div class="fm"><Image src={p.img} alt="" width={480} loading={i < 2 ? 'eager' : 'lazy'} /></div>
                  ) : p.inv ? (
                    <div class="fm dk"><Image src={p.inv} alt="" width={480} loading="lazy" /></div>
                  ) : (
                    <div class:list={['fm', 'tph', { dk: p.dark }]}><span class="tph-l">{p.name}</span><span class="tph-s">{p.ph}</span></div>
                  )}
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>

      <div class="cat" id="work">
        {BOXES.map((b) => (
          <article class="box" id={`b-${b.key}`}>
            <div class="bxh"><div class="l"><h2>{b.label}</h2></div></div>
            <div class={b.key === 'logos' ? 'lgrid' : b.key === 'websites' ? 'pgrid' : 'vlist'}>
              {panel[b.key].map((item) => <Tile item={item} web={b.key === 'websites'} />)}
            </div>
            <a href={workHref[b.key]} class="more">All {b.label.toLowerCase()} →</a>
          </article>
        ))}
      </div>
    </section>

    <section class="mess pad" id="mess" aria-labelledby="mess-h">
      <div class="mess-field" aria-hidden="true">
        {PIECES.map((pc, i) => (
          <span class="tk" data-k={i} style={`left:${spots[i]?.x ?? 50}%;top:${spots[i]?.y ?? 50}%;--r:${spots[i]?.r ?? 0}deg;--fd:${(i % 7) * -0.9}s`}>
            {pc.brand ? <svg class="br" viewBox="0 0 24 24"><path d={BRANDS[pc.brand]} /></svg> : pc.icon ? <svg viewBox="0 0 24 24" set:html={ICONS[pc.icon]} /> : <b>{pc.word}</b>}
          </span>
        ))}
      </div>
      <h2 class="mess-h rv" id="mess-h">Marketing requires a system.</h2>
    </section>

    <section class="sec proc pad" id="process" aria-labelledby="process-h">
      <p class="eyebrow">Our process</p>
      <h2 class="rv" id="process-h">We simplify it for you.</h2>
      <ol class="steps">
        {PROCESS.map((st, i) => (
          <li class="step rv" style={`--d:${i * 0.08}s`}>
            <span class="num">{String(i + 1).padStart(2, '0')}</span>
            <h3>{st.title}</h3>
            <p>{st.blurb}</p>
            <ul class="slots" aria-label={`What this step covers`}>
              {PIECES.map((pc, k) => pc.step === i && (
                <li class="tk slot" data-k={k} title={pc.label}>
                  {pc.brand ? <><svg class="br" viewBox="0 0 24 24" aria-hidden="true"><path d={BRANDS[pc.brand]} /></svg><span class="sr">{pc.label}</span></> : pc.icon ? <><svg viewBox="0 0 24 24" aria-hidden="true" set:html={ICONS[pc.icon]} /><span class="sr">{pc.label}</span></> : <b>{pc.word}</b>}
                </li>
              ))}
            </ul>
          </li>
        ))}
      </ol>
    </section>

    <section class="sec sys pad" id="system" aria-labelledby="system-h">
      <div class="sys-wrap">
      <div class="sys-text">
      <div class="sys-head">
        <p class="eyebrow">What we build</p>
        <h2 class="rv" id="system-h">One system.<br />Every piece connected.</h2>
        <p class="rv">Your brand, your website, how people find you and how you follow up, designed to work together and look consistent instead of built one piece at a time.</p>
      </div>
      <ol class="sys-list">
        {SYSTEM.map((s, i) => (
          <li class="sys-row rv">
            <span class="num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <h3><span class="t">{s.title}</span></h3>
            <div class="sys-body">
              <p>{s.blurb}</p>
              <ul class="tags" aria-label={`${s.title} includes`}>{s.tags.map((t) => <li>{t}</li>)}</ul>
            </div>
          </li>
        ))}
      </ol>
      </div>
      <aside class="sys-map" id="sysmap" aria-hidden="true">
        <div class="sm-box">
          <svg class="sm-lines" viewBox="0 0 100 100" preserveAspectRatio="none">
            {SYSMAP.map((g, i) => {
              const n = SYSMAP[(i + 1) % SYSMAP.length]!;
              return <path class="ln ring" data-g={i} pathLength="1" d={`M${g.x} ${g.y}L${n.x} ${n.y}`} />;
            })}
            {SYSMAP.map((g, i) => <path class="ln hub" data-g={i} pathLength="1" d={`M50 50L${g.x} ${g.y}`} />)}
            {SYSMAP.map((g, i) => g.items.map((it) => <path class="ln leaf" data-g={i} pathLength="1" d={`M${g.x} ${g.y}L${it.x} ${it.y}`} />))}
          </svg>
          <span class="sm-core" style="left:50%;top:50%" />
          {SYSMAP.map((g, i) => (
            <>
              <span class="sm-anc" data-g={i} style={`left:${g.x}%;top:${g.y}%`} />
              {g.items.map((it) => (
                <span class="sm-n tk" data-g={i} style={`left:${it.x}%;top:${it.y}%`} title={it.label}>
                  {it.brand ? <svg class="br" viewBox="0 0 24 24"><path d={BRANDS[it.brand]} /></svg> : <svg viewBox="0 0 24 24" set:html={ICONS[it.icon!]} />}
                </span>
              ))}
            </>
          ))}
        </div>
      </aside>
      </div>
      <svg class="sm-link" id="smlink" aria-hidden="true"><path /></svg>
    </section>

    <section class="sec pick pad" id="handoff" aria-labelledby="pick-h">
      <p class="eyebrow">Once it's built</p>
      <h2 class="rv" id="pick-h">Your system, your call.</h2>
      <div class="choices">
        {CHOICES.map((c, i) => (
          <article class:list={['choice', 'rv', { dark: i === 1 }]} style={`--d:${i * 0.1}s`}>
            <p class="k">{c.kicker}</p>
            <h3>{c.title}</h3>
            <p class="b">{c.blurb}</p>
            <p class="n">{c.note}</p>
          </article>
        ))}
      </div>
      <div class="sfoot"><p>Just need social, or a website? Start there. The rest can come later.</p><a href={CONTACT.booking}>Book a visit →</a></div>
    </section>


  <script id="hero-data" type="application/json" set:html={JSON.stringify(HERO)} />
  <script src="../scripts/home.ts"></script>
</Base>
