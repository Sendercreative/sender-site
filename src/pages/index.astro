---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Tile from '../components/Tile.astro';
import { WORK, BOXES, HERO, PROCESS, SYSTEM, CHOICES, PAGES, CONTACT } from '../data/site';
import '../styles/home.css';

const W = WORK;
const deck = [W.logos[0], W.videos[0], W.logos[2], W.logos[1], W.websites[0], W.logos[3], W.logos[4]].filter(Boolean);
const letters = (s: string) => [...s];
---
<Base>
  <nav class="nav pad" aria-label="Primary">
    <a href="/" class="logo" id="logo" aria-label="Sender Creative home">
      <span class="lm"><img src="/media/sender-white.png" alt="" width="1257" height="219" /></span>
      <span class="lw"><img src="/media/sender-white.png" alt="" width="1257" height="219" /></span>
    </a>
    <button class="mbtn" id="mbtn" aria-label="Menu" aria-expanded="false" aria-controls="ov">
      <span class="w" aria-hidden="true"><span>Menu</span><span>Menu</span><span>Close</span></span>
      <span class="ic" aria-hidden="true"><i></i><i></i></span>
    </button>
  </nav>

  <div class="ov" id="ov" aria-hidden="true">
    <div class="bgfx" aria-hidden="true"><b></b><b></b><b></b></div>
    <div class="mask pad">
      <nav class="mlist" id="mlist" aria-label="Menu">
        {PAGES.map((p, i) => (
          <a class="ml" href={p.href} data-i={i} data-title={p.title} data-blurb={p.blurb} tabindex="-1">
            <span aria-hidden="true">{letters(p.title).map((c, j) => <i style={`transition-delay:${(0.25 + i * 0.07 + j * 0.025).toFixed(3)}s`}>{c}</i>)}</span>
            <span class="sr-only">{p.title}</span>
          </a>
        ))}
      </nav>
    </div>
    <div class="mprev" id="mprev" aria-hidden="true"><b></b><span></span></div>
    <div class="mfoot pad">
      <a href={`mailto:${CONTACT.email}`} tabindex="-1">{CONTACT.email}</a>
      <span>{CONTACT.location}</span>
      <span><a href={CONTACT.instagram} tabindex="-1">Instagram</a> · <a href={CONTACT.linkedin} tabindex="-1">LinkedIn</a></span>
    </div>
  </div>

  <main>
    <section class="stage" id="stage" aria-label="Introduction and work">
      <div class="pin">
        <div class="bgfx" aria-hidden="true"><b></b><b></b><b></b></div>
        <div class="mask">
          <div class="htxt pad">
            <div class="hblk" id="hblk">
              <span class="lk" id="lk" aria-hidden="true">{letters(HERO[0].word).map((c) => <i>{c}</i>)}</span>
              <h1 class="ag" id="ag" aria-label={`${HERO[0].word} ${HERO[0].lines.join(' ')}`}>
                {HERO[0].lines.map((t) => <span class="pop" aria-hidden="true"><span>{t}</span></span>)}
              </h1>
            </div>
          </div>
        </div>
        <p class="lede" id="lede"><b style="font-weight:400">We'll help you <span>send</span> the right message, in all the right places.</b></p>
        <div class="sub pad" aria-hidden="true"><span>Sender Creative · {CONTACT.location}</span><span>Scroll ↓</span></div>
        <nav class="rail" id="rail" aria-label="Work sections">
          {BOXES.map((b) => <a href={`#b-${b.key}`} aria-label={b.label}><span>{b.label}</span></a>)}
        </nav>

        <div class="fly" aria-hidden="true">
          <div class="deck">
            {deck.map((p, i) => (
              <div class="fc" style={`--i:${Math.max(0, 3 - i)}`}>
                <div class="fi">
                  {p.video ? (
                    <div class="fm dk"><video src={p.video.src} poster={p.video.poster} autoplay muted loop playsinline preload="metadata"></video></div>
                  ) : p.img ? (
                    <div class="fm"><Image src={p.img} alt="" width={480} loading={i < 2 ? 'eager' : 'lazy'} /></div>
                  ) : p.inv ? (
                    <div class="fm dk"><Image src={p.inv} alt="" width={480} loading="lazy" /></div>
                  ) : (
                    <div class="fm web"><span>{p.ph}</span></div>
                  )}
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>

      <div class="cat" id="work">
        {BOXES.map((b) => (
          <article class="box" id={`b-${b.key}`}>
            <div class="bxh"><div class="l"><h2>{b.label}</h2></div></div>
            <div class={b.key === 'logos' ? 'lgrid' : 'vlist'}>
              {W[b.key].map((item) => <Tile item={item} />)}
            </div>
            <a href="#" class="more">All {b.label.toLowerCase()} →</a>
          </article>
        ))}
      </div>
    </section>

    <section class="sec proc pad" id="process" aria-labelledby="process-h">
      <p class="eyebrow">Our process</p>
      <h2 class="rv" id="process-h">Simple on your end.</h2>
      <ol class="steps">
        {PROCESS.map((st, i) => (
          <li class="step rv" style={`--d:${i * 0.08}s`}>
            <span class="num">{String(i + 1).padStart(2, '0')}</span>
            <h3>{st.title}</h3>
            <p>{st.blurb}</p>
          </li>
        ))}
      </ol>
    </section>

    <section class="sec svc pad" id="system" aria-labelledby="system-h">
      <div class="svh">
        <div>
          <p class="eyebrow" style="margin-bottom:24px;font-size:clamp(14px,1.2vw,18px)">What we build</p>
          <h2 class="rv" id="system-h">One system.<br />Every piece connected.</h2>
        </div>
        <p class="rv">Your brand, your website, how people find you and how you follow up, built to work together instead of bought one piece at a time.</p>
      </div>
      <div class="slist" id="slist">
        {SYSTEM.map((s) => (
          <div class="si rv" tabindex="0" role="button" aria-expanded="false">
            <div class="sl">
              <h3>{s.title}</h3>
              <div class="more2"><div class="tags">{s.tags.map((t) => <span>{t}</span>)}</div></div>
            </div>
            <div class="sp">
              <div class="img"><div class="ph">{s.title}</div></div>
              <div class="txt"><p>{s.blurb}</p><a href={CONTACT.booking} tabindex="-1">Book a visit →</a></div>
            </div>
          </div>
        ))}
      </div>
    </section>

    <section class="sec pick pad" id="handoff" aria-labelledby="pick-h">
      <p class="eyebrow">Once it's built</p>
      <h2 class="rv" id="pick-h">Your system, your call.</h2>
      <div class="choices">
        {CHOICES.map((c, i) => (
          <article class:list={['choice', 'rv', { dark: i === 1 }]} style={`--d:${i * 0.1}s`}>
            <p class="k">{c.kicker}</p>
            <h3>{c.title}</h3>
            <p class="b">{c.blurb}</p>
            <p class="n">{c.note}</p>
          </article>
        ))}
      </div>
      <div class="sfoot"><p>Just need social, or a website? Start there. The rest can come later.</p><a href={CONTACT.booking}>Book a visit →</a></div>
    </section>

    <section class="end pad" id="contact" aria-labelledby="contact-h">
      <p class="eyebrow" style="margin-bottom:28px">Start here</p>
      <h2 class="rv" id="contact-h">Ready to send it?</h2>
      <div class="cta-row">
        <a class="btn-light" href={CONTACT.booking}>Book a visit →</a>
        <a class="mail" href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a>
      </div>
      <div class="big" role="img" aria-label="Sender"></div>
      <footer class="foot" style="padding-left:0;padding-right:0">
        <span>© {new Date().getFullYear()} Sender Creative</span>
        <span><a href={CONTACT.instagram}>Instagram</a> · <a href={CONTACT.linkedin}>LinkedIn</a></span>
      </footer>
    </section>
  </main>

  <script id="hero-data" type="application/json" set:html={JSON.stringify(HERO)} />
  <script src="../scripts/home.ts"></script>
</Base>
