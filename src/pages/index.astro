---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Tile from '../components/Tile.astro';
import { WORK, BOXES, HERO, PROCESS, SYSTEM, CHOICES, CONTACT } from '../data/site';
import '../styles/home.css';

const W = WORK;
const deck = [W.logos[0], W.websites[1], W.logos[3], W.websites[5], W.logos[2], W.websites[4], W.logos[4]].filter(Boolean);
const letters = (s: string) => [...s];
const workHref = { logos: '/work/#branding', videos: '/work/#video', websites: '/work/#websites' } as const;
---
<Base page="home">
    <section class="stage" id="stage" aria-label="Introduction and work">
      <div class="pin">
        <div class="bgfx" aria-hidden="true"><b></b><b></b><b></b></div>
        <div class="mask">
          <div class="htxt pad">
            <div class="hblk" id="hblk">
              <span class="lk" id="lk" aria-hidden="true">{letters(HERO[0].word).map((c) => <i>{c}</i>)}</span>
              <h1 class="ag" id="ag" aria-label={`${HERO[0].word} ${HERO[0].lines.join(' ')}`}>
                {HERO[0].lines.map((t) => <span class="pop" aria-hidden="true"><span>{t}</span></span>)}
              </h1>
            </div>
          </div>
        </div>
        <p class="lede" id="lede"><b style="font-weight:400">We'll help you <span>send</span> the right message, in all the right places.</b></p>
        <div class="sub pad"><span>Marketing for local businesses · {CONTACT.areas}</span><span aria-hidden="true">Scroll ↓</span></div>
        <nav class="rail" id="rail" aria-label="Work sections">
          {BOXES.map((b) => <a href={`#b-${b.key}`} aria-label={b.label}><span>{b.label}</span></a>)}
        </nav>

        <div class="fly" aria-hidden="true">
          <div class="deck">
            {deck.map((p, i) => (
              <div class="fc" style={`--i:${Math.max(0, 3 - i)}`}>
                <div class="fi">
                  {p.video ? (
                    <div class="fm dk"><video src={p.video.src} poster={p.video.poster} autoplay muted loop playsinline preload="metadata"></video></div>
                  ) : p.shot ? (
                    <div class="fm shot"><Image src={p.shot} alt="" widths={[640, 960]} sizes="40vw" loading="lazy" /></div>
                  ) : p.img ? (
                    <div class="fm"><Image src={p.img} alt="" width={480} loading={i < 2 ? 'eager' : 'lazy'} /></div>
                  ) : p.inv ? (
                    <div class="fm dk"><Image src={p.inv} alt="" width={480} loading="lazy" /></div>
                  ) : (
                    <div class:list={['fm', 'tph', { dk: p.dark }]}><span class="tph-l">{p.name}</span><span class="tph-s">{p.ph}</span></div>
                  )}
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>

      <div class="cat" id="work">
        {BOXES.map((b) => (
          <article class="box" id={`b-${b.key}`}>
            <div class="bxh"><div class="l"><h2>{b.label}</h2></div></div>
            <div class={b.key === 'logos' ? 'lgrid' : 'vlist'}>
              {W[b.key].map((item) => <Tile item={item} web={b.key === 'websites'} />)}
            </div>
            <a href={workHref[b.key]} class="more">All {b.label.toLowerCase()} →</a>
          </article>
        ))}
      </div>
    </section>

    <section class="sec proc pad" id="process" aria-labelledby="process-h">
      <p class="eyebrow">Our process</p>
      <h2 class="rv" id="process-h">Simple on your end.</h2>
      <ol class="steps">
        {PROCESS.map((st, i) => (
          <li class="step rv" style={`--d:${i * 0.08}s`}>
            <span class="num">{String(i + 1).padStart(2, '0')}</span>
            <h3>{st.title}</h3>
            <p>{st.blurb}</p>
          </li>
        ))}
      </ol>
    </section>

    <section class="sec sys pad" id="system" aria-labelledby="system-h">
      <div class="sys-head">
        <p class="eyebrow">What we build</p>
        <h2 class="rv" id="system-h">One system.<br />Every piece connected.</h2>
        <p class="rv">Your brand, your website, how people find you and how you follow up, built to work together instead of bought one piece at a time.</p>
      </div>
      <ol class="sys-list">
        {SYSTEM.map((s, i) => (
          <li class="sys-row rv">
            <span class="num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <h3>{s.title}</h3>
            <div class="sys-body">
              <p>{s.blurb}</p>
              <ul class="tags" aria-label={`${s.title} includes`}>{s.tags.map((t) => <li>{t}</li>)}</ul>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <section class="sec pick pad" id="handoff" aria-labelledby="pick-h">
      <p class="eyebrow">Once it's built</p>
      <h2 class="rv" id="pick-h">Your system, your call.</h2>
      <div class="choices">
        {CHOICES.map((c, i) => (
          <article class:list={['choice', 'rv', { dark: i === 1 }]} style={`--d:${i * 0.1}s`}>
            <p class="k">{c.kicker}</p>
            <h3>{c.title}</h3>
            <p class="b">{c.blurb}</p>
            <p class="n">{c.note}</p>
          </article>
        ))}
      </div>
      <div class="sfoot"><p>Just need social, or a website? Start there. The rest can come later.</p><a href={CONTACT.booking}>Book a visit →</a></div>
    </section>


  <script id="hero-data" type="application/json" set:html={JSON.stringify(HERO)} />
  <script src="../scripts/home.ts"></script>
</Base>
